{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "scripts",
    "e2e",
    "web/src",
    "web/tests",
    "platform/design/src",
    "platform/design/tests",
    "plugins/*/frontend/src",
    "plugins/*/frontend/tests"
  ]
}
